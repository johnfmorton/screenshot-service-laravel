APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional: CloudFront URL for serving screenshots (e.g., https://d1234abcd.cloudfront.net)
AWS_URL=
# Optional: S3 prefix path for screenshots (default: screenshots)
AWS_SCREENSHOT_STORAGE_PATH=screenshots
# Upload with a public-read ACL. Set false when serving through CloudFront with
# origin access control, and keep the bucket's Block Public Access on.
SCREENSHOT_S3_PUBLIC_ACL=true

VITE_APP_NAME="${APP_NAME}"

# Screenshot Configuration
SCREENSHOT_CHROME_PATH=/usr/bin/chromium-browser

# values: s3, public (i.e., the local server)
SCREENSHOT_STORAGE_DISK=s3

SCREENSHOT_TTL_HOURS=24
SCREENSHOT_DEFAULT_VIEWPORT_WIDTH=1280
SCREENSHOT_DEFAULT_VIEWPORT_HEIGHT=800
SCREENSHOT_DEFAULT_THUMBNAIL_WIDTH=400
SCREENSHOT_DEFAULT_THUMBNAIL_HEIGHT=300
SCREENSHOT_DEFAULT_TIMEOUT=120
# Seconds a networkidle capture waits for the page to go quiet before capturing
# at the load event instead (0 = wait the full timeout for idleness)
SCREENSHOT_NETWORK_IDLE_TIMEOUT=30

# How long a capture may wait in the queue before its deadline expires. Queued
# time counts against the job's deadline, and an expired job is failed without
# ever running — raise this if captures queue deeper than half an hour.
SCREENSHOT_QUEUE_WAIT_GRACE=1800
SCREENSHOT_CHROME_MEMORY_OPTIMIZED=true
# Keep Chrome's sandbox on. Disable only where it can't start (running as root,
# or a container with Docker's default seccomp profile, e.g. DDEV).
SCREENSHOT_CHROME_SANDBOX=true

# --single-process saves memory but is a strong bot-detection signal and
# crashes on heavy pages. Only enable if you are genuinely memory constrained.
SCREENSHOT_CHROME_SINGLE_PROCESS=false

# Use modern headless Chrome instead of the easily fingerprinted legacy shell
SCREENSHOT_NEW_HEADLESS=true

# Retry blocked captures once through this proxy, e.g. a residential line over
# Tailscale: http://100.x.y.z:3128. It must refuse private destinations.
# SCREENSHOT_BLOCKED_RETRY_PROXY=
# Hide navigator.webdriver from page scripts. Opt-in: it disguises automation,
# and some sites' terms forbid circumventing their bot protection.
SCREENSHOT_HIDE_AUTOMATION=false
# Force HTTP/1.1 to avoid net::ERR_HTTP2_PROTOCOL_ERROR on some sites/CDNs
SCREENSHOT_FORCE_HTTP1=true
# Default user agent for requests that don't specify one. Leave this unset:
# it is then built from the installed Chrome, so its version always matches the
# sec-ch-ua headers Chrome sends and stays correct across browser upgrades.
# Set it only to pin something specific, and keep the version current yourself.
# SCREENSHOT_DEFAULT_USER_AGENT=
SCREENSHOT_ACCEPT_LANGUAGE="en-US,en;q=0.9"

# Most captures one API key may have queued or running at once (0 = no cap)
SCREENSHOT_MAX_PENDING_PER_KEY=25
# Capture and webhook URLs must resolve to public addresses. Enable only for
# local development (e.g. capturing a *.ddev.site URL) - never in production.
SCREENSHOT_ALLOW_PRIVATE_URLS=false
# Bot-protection handling. Records WAF blocks and challenge interstitials as
# 'blocked' instead of storing and caching the block page as a real screenshot.
SCREENSHOT_DETECT_BLOCKS=true
# Treat 4xx/5xx as a failed capture (set false to screenshot error pages)
SCREENSHOT_FAIL_ON_ERROR_RESPONSE=true
# How long to let a "verifying your browser" interstitial resolve, in ms
SCREENSHOT_CHALLENGE_WAIT_MS=15000

# Admin Credentials (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
